# Single application mode: npm run dev starts dashboard + the LinkedIn WhatsApp bot.
# Do not run the standalone bot or NanoClaw entrypoint at the same time.
APP_RUNTIME=unified

# Timezone for scheduled tasks (the 9am LinkedIn drafter uses this)
TZ=Asia/Karachi

# Standalone LinkedIn agent: use npm run linkedin:bot (no Claude/OneCLI needed)
OPENROUTER_API_KEY=
LINKEDIN_OWNER_JID=923001234567@s.whatsapp.net
LINKEDIN_TOPICS=AI agents, LLMs, Python, Django, RAG, backend engineering
LINKEDIN_RSS_FEEDS=https://techcrunch.com/feed/,https://www.infoq.com/feed/
LINKEDIN_DAILY_TIME=09:00
# Keep false until OAuth and approval have been tested
LINKEDIN_PUBLISH_ENABLED=false
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
LINKEDIN_API_VERSION=202608

# Set to true if the assistant runs on its own WhatsApp number
ASSISTANT_HAS_OWN_NUMBER=

# Credential gateway URL (OneCLI), set by `npm run setup`
ONECLI_URL=

# Preferred AI providers for Andy (separate API billing/credits may apply)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
GEMINI_API_KEY=
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-lite-image
GEMINI_IMAGE_SIZE=1K
GEMINI_IMAGE_ASPECT_RATIO=4:5
AI_IMAGE_ENABLED=true
OPENROUTER_TEXT_MODEL=openai/gpt-6.1-terra\nOPENROUTER_IMAGE_FALLBACKS=openai/gpt-5-image-mini,google/gemini-3.1-flash-image,openai/gpt-5-image\n
# Multi-user Andy web workspace (separate from the existing single-user bot)
PLATFORM_PORT=4177
PLATFORM_SETUP_KEY=generate-a-long-random-one-time-setup-key
PLATFORM_ENCRYPTION_KEY=generate-a-long-random-encryption-key
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:4177/api/linkedin/callback
